{
  "expo": {
    "name": "Conversation OS",
    "slug": "cvos",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.jpg",
    "splash": {
      "image": "./assets/splash.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.astuteweb.cvos"
    },
    "android": {
      "package": "com.astuteweb.cvos"
    },
    "plugins": [
      "./plugins/withCustomKeyboard.js"
    ],
    "extra": {
      "eas": {
        "projectId": "d36e2efd-5a6b-4c6a-8187-ee1a7764455f"
      }
    }
  }
}
